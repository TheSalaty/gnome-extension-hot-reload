{
  "name": "gnome-extension-hot-reload",
  "version": "0.2.0",
  "description": "Hot reload for GNOME Shell extensions: reloads an extension as soon as its files change, without logging out (Wayland, GNOME 45-50)",
  "keywords": [
    "gnome",
    "gnome-shell",
    "gnome-shell-extension",
    "hot-reload",
    "live-reload",
    "wayland",
    "gjs",
    "extension-development"
  ],
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSalaty/gnome-extension-hot-reload"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "make test"
  },
  "devDependencies": {
    "@girs/gnome-shell": "^50.0.4",
    "typescript": "^5.0.0"
  }
}
